#!/usr/bin/env bash
# Terminal entry point (the `zt` workflow). Works inside tmux (switches
# session) and outside (starts the server if needed and attaches).

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

usage() {
  cat <<'EOF'
tmux-cockpit

Usage:
  cockpit                         Open the project picker
  cockpit .                       Open current directory as a project session
  cockpit <path>                  Open a path as a project session
  cockpit <query...>              Open best zoxide match as a project session
  cockpit -                       Switch to the previous tmux session

Worktrees:
  cockpit -w                      Worktree picker for the current repo
  cockpit . -w                    Worktree picker for the current repo
  cockpit <query> -w              Worktree picker for a zoxide/path repo
  cockpit . -w <branch>           Open existing worktree for branch, or create it
  cockpit <query> -w <branch>     Same, after resolving query/path to a repo
  cockpit . -w <branch> --path <dir>
                                  Create at a custom path if it does not exist

Features (multi-repo):
  cockpit -f                      Feature picker (name it, then select repos)
  cockpit -f <name>               Feature picker with the name pre-filled
  cockpit -f <name> <repo>...     Create feature <name> from the given repos
                                  (each <repo> is a path or a zoxide query)

Options:
  -w, --worktree                  Use git worktree mode
  -f, --feature                   Use multi-repo feature mode
  --path <dir>                    Custom worktree destination for -w <branch>
  -h, --help                      Show this help

Examples:
  cockpit .
  cockpit api
  cockpit -
  cockpit -w
  cockpit . -w fix-agent-popup
  cockpit tmux-cockpit -w review/readme --path ~/Desktop/review-readme
  cockpit -f checkout-flow
  cockpit -f checkout-flow api web payments
EOF
}

resolve_project_arg() {
  if [ "$#" -eq 0 ]; then
    (cd . && pwd)
    return 0
  fi

  if [ "$#" -eq 1 ] && [ -d "$1" ]; then
    (cd "$1" && pwd)
    return 0
  fi

  if ! command -v zoxide >/dev/null 2>&1; then
    echo "cockpit: zoxide is required for query mode (brew install zoxide)" >&2
    return 1
  fi

  zoxide query -- "$@" || {
    echo "cockpit: no match for: $*" >&2
    return 1
  }
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

worktree_mode=""
feature_mode_flag=""
path_arg=""
before=()
after=()
feat=()
seen_worktree=""
seen_feature=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -w|--worktree)
      worktree_mode=1
      seen_worktree=1
      shift
      ;;
    -f|--feature)
      feature_mode_flag=1
      seen_feature=1
      shift
      ;;
    --path)
      shift
      if [ "$#" -eq 0 ]; then
        echo "cockpit: --path requires a directory" >&2
        exit 2
      fi
      path_arg="$1"
      shift
      ;;
    *)
      if [ -n "$seen_feature" ]; then
        feat+=("$1")
      elif [ -n "$seen_worktree" ]; then
        after+=("$1")
      else
        before+=("$1")
      fi
      shift
      ;;
  esac
done

# Multi-repo feature: `cockpit -f` (interactive picker), `cockpit -f <name>`
# (picker with the name pre-filled), or `cockpit -f <name> <repo>...` to
# create it non-interactively. Each <repo> is resolved like a project arg
# (a path, or a single zoxide query).
if [ -n "$feature_mode_flag" ]; then
  if [ "${#feat[@]}" -le 1 ]; then
    exec "$ROOT/scripts/feature-picker.sh" "${feat[@]}"
  fi
  name="${feat[0]}"
  repos=()
  i=1
  while [ "$i" -lt "${#feat[@]}" ]; do
    repo_path="$(resolve_project_arg "${feat[$i]}")" || exit 1
    repos+=("$repo_path")
    i=$((i + 1))
  done
  exec "$ROOT/scripts/open-feature.sh" "$name" "${repos[@]}"
fi

if [ -n "$worktree_mode" ]; then
  if [ "${#before[@]}" -eq 0 ]; then
    before=(.)
  fi
  repo_path="$(resolve_project_arg "${before[@]}")" || exit 1
  if [ "${#after[@]}" -eq 0 ]; then
    exec "$ROOT/scripts/worktree-picker.sh" "D:$repo_path"
  fi
  branch="${after[0]}"
  exec "$ROOT/scripts/open-worktree.sh" "$repo_path" "$branch" "$path_arg"
fi

if [ "${#before[@]}" -eq 0 ]; then
  exec "$ROOT/scripts/picker.sh"
fi

# 'cockpit -' — previous session, like cd -. Outside tmux, plain attach
# already picks the most recently active session.
if [ "${#before[@]}" -eq 1 ] && [ "${before[0]}" = "-" ]; then
  if [ -n "$TMUX" ]; then
    exec tmux switch-client -l
  else
    exec tmux attach-session
  fi
fi

dest="$(resolve_project_arg "${before[@]}")" || exit 1
exec "$ROOT/scripts/open-project.sh" "$dest"
