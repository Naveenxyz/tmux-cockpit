#!/usr/bin/env bash
# Terminal entry point (the `zt` workflow). Works inside tmux (switches
# session) and outside (starts the server if needed and attaches).
#   cockpit              — fuzzy-pick a project, open/attach its session
#   cockpit .            — session for the current directory
#   cockpit -            — back to the previous session (like cd -)
#   cockpit <path>       — session for a directory (relative or absolute)
#   cockpit <query...>   — resolve the query with zoxide and open its session
# Symlink it as `zt` (or anything else) — the name doesn't matter.

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ $# -eq 0 ]; then
  exec "$ROOT/scripts/picker.sh"
fi

# 'zt -' — previous session, like cd -. Outside tmux, plain attach already
# picks the most recently active session.
if [ "$1" = "-" ]; then
  if [ -n "$TMUX" ]; then
    exec tmux switch-client -l
  else
    exec tmux attach-session
  fi
fi

# A directory argument ('.', 'sub/dir', '/abs/path', '~/x' expanded by the
# shell) opens directly — no zoxide needed.
if [ $# -eq 1 ] && [ -d "$1" ]; then
  exec "$ROOT/scripts/open-project.sh" "$(cd "$1" && pwd)"
fi

if ! command -v zoxide >/dev/null 2>&1; then
  echo "cockpit: zoxide is required for query mode (brew install zoxide)" >&2
  exit 1
fi

dest="$(zoxide query -- "$@")" || { echo "cockpit: no match for: $*" >&2; exit 1; }
exec "$ROOT/scripts/open-project.sh" "$dest"
